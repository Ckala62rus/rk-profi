# Docker's embedded DNS resolves the PHP service at request time, so Nginx can
# start safely even while the app container is still joining the network.
resolver 127.0.0.11 ipv6=off valid=10s;

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};

    root /var/www/public;
    index index.php;
    client_max_body_size 200M;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        set $fastcgi_upstream ${NGINX_UPSTREAM};
        fastcgi_pass $fastcgi_upstream;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_X_FORWARDED_PROTO $scheme;
        fastcgi_param HTTP_X_FORWARDED_HOST $host;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_param HTTPS off;
        fastcgi_read_timeout 60s;
    }

    location ~ /\. {
        deny all;
    }
}
