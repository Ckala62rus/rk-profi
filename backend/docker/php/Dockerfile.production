FROM php:8.3-fpm-alpine AS php-base

RUN apk add --no-cache \
        bash \
        curl \
        freetype \
        icu-libs \
        libjpeg-turbo \
        libpng \
        libpq \
        libxml2 \
        libzip \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        freetype-dev \
        icu-dev \
        libjpeg-turbo-dev \
        libpng-dev \
        libxml2-dev \
        libzip-dev \
        linux-headers \
        postgresql-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        exif \
        gd \
        intl \
        opcache \
        pcntl \
        pdo_pgsql \
        pgsql \
        sockets \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps \
    && rm -rf /tmp/* /var/cache/apk/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

FROM php-base AS vendor

COPY backend/src/composer.json backend/src/composer.lock ./
RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --prefer-dist \
        --optimize-autoloader \
        --no-scripts

FROM node:22-alpine AS assets

WORKDIR /app/backend/src

COPY backend/src/package.json backend/src/package-lock.json ./
RUN npm ci

COPY backend/src ./
COPY frontend/src /app/frontend/src
RUN npm run build

FROM php-base AS php

COPY backend/docker/php/php.production.ini /usr/local/etc/php/conf.d/99-production.ini
COPY backend/docker/php/production-entrypoint.sh /usr/local/bin/production-entrypoint
RUN chmod +x /usr/local/bin/production-entrypoint

COPY --chown=www-data:www-data backend/src/ ./
COPY --from=vendor --chown=www-data:www-data /var/www/vendor ./vendor
COPY --from=assets --chown=www-data:www-data /app/backend/src/public/build ./public/build

RUN mkdir -p \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

ENTRYPOINT ["production-entrypoint"]
CMD ["php-fpm", "-F"]

FROM nginx:1.27-alpine AS nginx

COPY backend/docker/nginx/production/nginx.conf /etc/nginx/nginx.conf
COPY backend/docker/nginx/production/http.conf.template /etc/nginx/production-templates/http.conf.template
COPY backend/docker/nginx/production/https.conf.template /etc/nginx/production-templates/https.conf.template
COPY backend/docker/nginx/production/production-entrypoint.sh /usr/local/bin/production-entrypoint
COPY --from=php /var/www/public /var/www/public

RUN chmod +x /usr/local/bin/production-entrypoint

ENTRYPOINT ["production-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
