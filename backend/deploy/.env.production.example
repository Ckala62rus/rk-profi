# Единый production-файл для Docker Compose и Laravel.
# На сервере: cp deploy/.env.production.example .env.production
# HTTP сначала нужен для выпуска сертификата. После выпуска измените
# COMPOSE_PROFILES на https — будут одновременно доступны HTTP и HTTPS.

# Docker Compose / Nginx
COMPOSE_PROJECT_NAME=rkprofi
COMPOSE_PROFILES=http
APP_IMAGE_TAG=production
HTTP_PORT=80
HTTPS_PORT=443
# Оба домена сайта. Кириллический домен указывайте только в Punycode:
# ркпрофи.ру = xn--h1admddc3a.xn--p1ag
SERVER_NAME=rkprofi.ru xn--h1admddc3a.xn--p1ag
# Канонический домен: второй домен перенаправляется на него по HTTPS.
CANONICAL_HOST=rkprofi.ru
LETSENCRYPT_EMAIL=admin@example.com
# Имя каталога сертификата: канонический (англоязычный) домен.
LETSENCRYPT_CERT_NAME=rkprofi.ru

# Laravel
APP_NAME="РК ПРОФИ"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_OUTPUT_OF_ARTISAN_KEY_GENERATE
APP_DEBUG=false
# Канонический URL: английский домен. Второй домен перенаправляется на него.
APP_URL=http://rkprofi.ru
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL. Docker получает эти же DB_* значения: отдельных POSTGRES_* нет.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rkprofi
DB_USERNAME=rkprofi
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# PgAdmin. Порт привязан только к localhost VDS — доступ через SSH-туннель.
# Не меняйте на 0.0.0.0:5050 и не открывайте этот порт в UFW.
PGADMIN_PORT=127.0.0.1:5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PGADMIN_PASSWORD

# Application state
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTP после выпуска сертификата только перенаправляет на HTTPS.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Redis доступен только во внутренней Docker-сети.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Реальный SMTP обязателен для отправки заявок.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
LEAD_NOTIFY_EMAIL=REPLACE_WITH_LEAD_RECIPIENT_EMAIL

# CAPTCHA Turnstile: оставьте оба значения пустыми, если она не используется.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
# Для Laravel используйте канонический URL; оба домена перечислите для Sanctum.
FRONTEND_URL=http://rkprofi.ru
SANCTUM_STATEFUL_DOMAINS=rkprofi.ru,xn--h1admddc3a.xn--p1ag
