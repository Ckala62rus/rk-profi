APP_NAME="РК ПРОФИ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL в Docker (сервис postgres-rkprofi)
DB_CONNECTION=pgsql
DB_HOST=postgres-rkprofi
DB_PORT=5432
DB_DATABASE=rkprofi
DB_USERNAME=rkprofi
DB_PASSWORD=rkprofi

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis-rkprofi
REDIS_PASSWORD=null
REDIS_PORT=6379

# MailHog в Docker (UI: http://localhost:8026)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog-rkprofi
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rkprofi.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (пусто = капча выключена)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sanctum SPA (Vue) — подключим после фронта
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8090,127.0.0.1,127.0.0.1:5173,127.0.0.1:8090
