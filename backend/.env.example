# Docker Compose — порты и сервисы
# Скопируй в .env: copy .env.example .env

COMPOSE_PROJECT_NAME=rkprofi

# 8090 — чтобы не пересекаться с демо-сайтом (grabber) на 8080
NGINX_PORT=8090
POSTGRES_PORT=5433
REDIS_PORT=6380
PGADMIN_PORT=8082
MAILHOG_UI_PORT=8026
MAILHOG_SMTP_PORT=1026

POSTGRES_DB=rkprofi
POSTGRES_USER=rkprofi
POSTGRES_PASSWORD=rkprofi

# Не используйте *.local — pgAdmin 8+ отклоняет спец-домены (email-validator)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Xdebug (передаётся в контейнер backend-rkprofi, не в Laravel)
XDEBUG_MODE=develop,debug
XDEBUG_CONFIG=client_host=host.docker.internal client_port=9003
PHP_IDE_CONFIG=serverName=rkprofi

# SMTP для контейнера (Laravel читает MAIL_* из src/.env)
MAIL_MAILER=smtp
MAIL_HOST=mailhog-rkprofi
MAIL_PORT=1025
